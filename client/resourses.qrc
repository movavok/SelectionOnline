<RCC>
    <qresource prefix="/maps">
        <file alias="default.txt">assets/maps/default.txt</file>
    </qresource>
    <qresource prefix="/ui">
        <file alias="player_preview_bg.png">assets/ui/player_preview_bg.png</file>
    </qresource>
    <qresource prefix="/ui/icons">
        <file alias="katana.png">assets/ui/icons/katana.png</file>
    </qresource>
    <qresource prefix="/entities">
        <file alias="tank/tank_stand.png">assets/entities/tank/tank_stand.png</file>
        <file alias="tank/tank_walk_1.png">assets/entities/tank/tank_walk_1.png</file>
        <file alias="tank/tank_walk_2.png">assets/entities/tank/tank_walk_2.png</file>
        <file alias="ghost/ghost.png">assets/entities/ghost/ghost.png</file>
    </qresource>
    <qresource prefix="/weapons">
        <file alias="katana.png">assets/weapons/katana.png</file>
    </qresource>

    <qresource prefix="/attack/katana">
        <file alias="1.png">assets/attack/katana/1.png</file>
        <file alias="2.png">assets/attack/katana/2.png</file>
        <file alias="3.png">assets/attack/katana/3.png</file>
    </qresource>
    <qresource prefix="/tiles">
        <file alias="empty_1.png">assets/tiles/empty_1.png</file>
        <file alias="empty_2.png">assets/tiles/empty_2.png</file>
        <file alias="empty_3.png">assets/tiles/empty_3.png</file>

        <file alias="board.png">assets/tiles/board.png</file>
        <file alias="brick_cracked.png">assets/tiles/brick_cracked.png</file>
        <file alias="brick_strong.png">assets/tiles/brick_strong.png</file>
        <file alias="grass.png">assets/tiles/grass.png</file>
        <file alias="water.png">assets/tiles/water.png</file>
        <file alias="wall.png">assets/tiles/wall.png</file>
    </qresource>
</RCC>
